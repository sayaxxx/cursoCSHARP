@model BibliotecaApp.Models.Ejemplar

@{
    ViewData["Title"] = "Editar Ejemplar";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Inventario de Ejemplares</a></li>
        <li class="breadcrumb-item active" aria-current="page">Editar Ejemplar</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2"></i>Editar Información del Ejemplar
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="LibroId" class="form-label fw-semibold">Libro Perteneciente</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-book"></i></span>
                            <select asp-for="LibroId" class="form-select" asp-items="ViewBag.LibroId">
                            </select>
                        </div>
                        <span asp-validation-for="LibroId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Estado" class="form-label fw-semibold">Estado del Ejemplar</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-info-circle"></i></span>
                            <select asp-for="Estado" class="form-select">
                                <option value="Disponible">Disponible</option>
                                <option value="Prestado">Prestado</option>
                                <option value="En Reparación">En Reparación</option>
                                <option value="Perdido">Perdido</option>
                            </select>
                        </div>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                        </a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold shadow-sm">
                            <i class="bi bi-save me-1"></i> Actualizar Ejemplar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}