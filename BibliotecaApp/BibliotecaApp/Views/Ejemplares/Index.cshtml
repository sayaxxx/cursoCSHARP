@model IEnumerable<BibliotecaApp.Models.Ejemplar>

@{
    ViewData["Title"] = "Inventario de Ejemplares";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-collection-fill text-success me-2"></i>Inventario de Ejemplares
        </h1>
        <p class="text-muted mb-0">Control físico de copia de libros, estados de disponibilidad e historial de préstamos.</p>
    </div>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Registrar Nuevo Ejemplar
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Código / ID</th>
                        <th>Obra Perteneciente</th>
                        <th>Estado Físico</th>
                        <th>Historial de Préstamos</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                No hay ejemplares registrados en el inventario.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-tag-fill text-secondary me-1"></i>Ejemplar #@item.Id
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">
                                        <i class="bi bi-journal-bookmark me-1 text-primary"></i>@(item.Libro?.Titulo ?? "Sin obra asignada")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Estado == "Disponible")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Disponible
                                        </span>
                                    }
                                    else if (item.Estado == "Prestado")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">
                                            <i class="bi bi-arrow-repeat me-1"></i>Prestado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">
                                            @item.Estado
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.Prestamos != null && item.Prestamos.Any())
                                    {
                                        var totalPrestamos = item.Prestamos.Count();
                                        var ultimoPrestamo = item.Prestamos.OrderByDescending(p => p.FechaPrestamo).FirstOrDefault();

                                        <div>
                                            <span class="badge bg-secondary me-1">Total: @totalPrestamos</span>
                                            @if (ultimoPrestamo?.Usuario != null)
                                            {
                                                <small class="text-muted d-block mt-1">
                                                    Último: <strong>@ultimoPrestamo.Usuario.Nombre</strong>
                                                </small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin préstamos registrados</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>