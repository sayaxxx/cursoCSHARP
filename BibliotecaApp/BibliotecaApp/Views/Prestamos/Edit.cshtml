@model BibliotecaApp.Models.Prestamo

@{
    ViewData["Title"] = "Editar Préstamo";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Gestión de Préstamos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Editar Préstamo</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2"></i>Actualizar / Marcar Devolución
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="UsuarioId" class="form-label fw-semibold">Usuario Solicitante</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId">
                            </select>
                        </div>
                        <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EjemplarId" class="form-label fw-semibold">Ejemplar Prestado</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-book"></i></span>
                            <select asp-for="EjemplarId" class="form-select" asp-items="ViewBag.EjemplarId">
                            </select>
                        </div>
                        <span asp-validation-for="EjemplarId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaPrestamo" class="form-label fw-semibold">Fecha de Préstamo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                                <input asp-for="FechaPrestamo" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="FechaPrestamo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="FechaDevolucion" class="form-label fw-semibold">Fecha de Devolución</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar2-x"></i></span>
                                <input asp-for="FechaDevolucion" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="FechaDevolucion" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                        </a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold shadow-sm">
                            <i class="bi bi-save me-1"></i> Actualizar Registro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}