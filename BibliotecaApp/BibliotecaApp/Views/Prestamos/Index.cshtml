@model IEnumerable<BibliotecaApp.Models.Prestamo>

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-arrow-repeat text-warning me-2"></i>Gestión de Préstamos
        </h1>
        <p class="text-muted mb-0">Control de salida y devolución de ejemplares por usuario registrado.</p>
    </div>
    <a asp-action="Create" class="btn btn-warning text-dark fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Registrar Nuevo Préstamo
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Usuario</th>
                        <th>Ejemplar / Libro</th>
                        <th>Fecha de Préstamo</th>
                        <th>Fecha de Devolución</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                No hay registros de préstamos activos o pasados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-person-fill text-primary me-2"></i>@(item.Usuario?.Nombre ?? "Sin usuario")
                                    <small class="d-block text-muted fw-normal ms-4">@(item.Usuario?.Email)</small>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">
                                        <i class="bi bi-book me-1 text-secondary"></i>@(item.Ejemplar?.Libro?.Titulo ?? "Obra no cargada")
                                    </span>
                                    <small class="d-block text-muted">
                                        <span class="badge bg-light text-dark border">Ejemplar #@item.EjemplarId</span>
                                    </small>
                                </td>
                                <td>
                                    <span class="text-secondary">
                                        <i class="bi bi-calendar-check me-1"></i>@item.FechaPrestamo.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (item.FechaDevolucion.HasValue)
                                    {
                                        <span class="text-secondary">
                                            <i class="bi bi-calendar2-x me-1"></i>@item.FechaDevolucion.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic small">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    @if (item.FechaDevolucion == null)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-2 py-1">
                                            <i class="bi bi-clock-history text-warning me-1"></i>En Préstamo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Devuelto
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar / Marcar Devolución">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>