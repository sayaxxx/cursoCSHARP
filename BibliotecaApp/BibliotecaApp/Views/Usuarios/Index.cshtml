@model IEnumerable<BibliotecaApp.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-people-fill text-info me-2"></i>Gestión de Usuarios
        </h1>
        <p class="text-muted mb-0">Directorio de lectores registrados, información de contacto y estado de préstamos.</p>
    </div>
    <a asp-action="Create" class="btn btn-info text-white shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Registrar Nuevo Usuario
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Usuario</th>
                        <th>Correo Electrónico</th>
                        <th>Estado de Préstamos</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x-fill fs-1 d-block mb-2"></i>
                                No se encontraron usuarios registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-person-bounding-box me-2 text-info"></i>@Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td>
                                    <a href="mailto:@item.Email" class="text-decoration-none text-secondary">
                                        <i class="bi bi-envelope-fill me-1 text-muted"></i>@Html.DisplayFor(modelItem => item.Email)
                                    </a>
                                </td>
                                <td>
                                    @if (item.Prestamos != null && item.Prestamos.Any())
                                    {
                                        var total = item.Prestamos.Count();
                                        var activos = item.Prestamos.Count(p => p.FechaDevolucion == null);

                                        <div>
                                            <span class="badge bg-secondary me-1">
                                                Total: @total
                                            </span>
                                            @if (activos > 0)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">
                                                    <i class="bi bi-clock-history me-1"></i>@activos Activo(s)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                                    <i class="bi bi-check-all me-1"></i>Sin pendientes
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin préstamos registrados</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>