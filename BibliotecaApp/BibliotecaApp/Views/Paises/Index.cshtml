@model IEnumerable<BibliotecaApp.Models.Pais>

@{
    ViewData["Title"] = "Gestión de Países";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-globe-americas text-secondary me-2"></i>Gestión de Países
        </h1>
        <p class="text-muted mb-0">Catálogo de países de origen para la clasificación de autores.</p>
    </div>
    <a asp-action="Create" class="btn btn-secondary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Registrar Nuevo País
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">País</th>
                        <th>Autores Vinculados</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="bi bi-geo-alt-fill fs-1 d-block mb-2"></i>
                                No hay países registrados en la base de datos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-flag-fill me-2 text-danger"></i>@Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td>
                                    @if (item.Autores != null && item.Autores.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span class="badge bg-secondary me-1">Total: @item.Autores.Count()</span>
                                            @foreach (var autor in item.Autores)
                                            {
                                                <span class="badge bg-light text-dark border">
                                                    <i class="bi bi-person me-1"></i>@autor.Nombre
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin autores asociados</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>