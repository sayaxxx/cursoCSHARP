@model BibliotecaApp.Models.Autor

@{
    ViewData["Title"] = "Detalles del Autor";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Gestión de Autores</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalles</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-person-badge me-2"></i>Información del Autor
                </h5>
                <span class="badge bg-light text-dark">ID #@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-12 mb-3">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Nombre Autor</label>
                        <span class="fs-4 fw-bold text-dark"><i class="bi bi-person-circle text-primary me-2"></i>@Model.Nombre</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Fecha de Nacimiento</label>
                        <span class="fs-6 text-secondary"><i class="bi bi-calendar-event me-1"></i>@Model.FechaNacimiento.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small text-uppercase fw-semibold d-block">País de Origen</label>
                        <span class="badge bg-light text-dark border fs-6">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(Model.Pais?.Nombre ?? "Sin especificar")
                        </span>
                    </div>
                </div>

                <hr />

                <!-- Obras asociadas -->
                <div class="mb-3">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-journal-bookmark me-1 text-primary"></i>Libros Publicados</h6>
                    @if (Model.LibroAutores != null && Model.LibroAutores.Any())
                    {
                        <div class="list-group list-group-flush border rounded">
                            @foreach (var la in Model.LibroAutores)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-book text-primary me-2"></i>@la.Libro?.Titulo</span>
                                    <span class="badge bg-light text-dark border">ISBN: @la.Libro?.ISBN</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">No hay libros registrados asociados a este autor.</p>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Regresar a la Lista
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-bold">
                        <i class="bi bi-pencil-fill me-1"></i> Editar Autor
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>